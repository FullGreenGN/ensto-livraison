# Copy this file to .env and fill in your values
# Used by docker-compose.yml

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=ensto
POSTGRES_PASSWORD=ensto_secret
POSTGRES_DB=ensto_db
POSTGRES_PORT=5432

# Prisma / app DATABASE_URL (built from the values above)
DATABASE_URL="postgresql://ensto:ensto_secret@localhost:5432/ensto_db"

# ── pgAdmin (optional – start with: docker compose --profile tools up) ────────
PGADMIN_EMAIL=admin@ensto.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

