# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ensto:ensto_secret@localhost:5432/ensto_db"

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET="change_me_to_a_long_random_secret_before_production"
JWT_EXPIRES_IN="8h"

# ── GDPR Encryption (AES-256-GCM) ─────────────────────────────────────────────
# Generate: openssl rand -hex 32
# CRITICAL: Back this up. Losing it makes all encrypted fields unrecoverable.
ENCRYPTION_KEY="your_64_char_hex_string_here"

# ── CORS ──────────────────────────────────────────────────────────────────────
WEB_ORIGIN="http://localhost:3000"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

